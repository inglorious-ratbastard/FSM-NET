@model myapp.Pages.YapModel

<style>
html, body {
  font-size: 12px;
}
#yap-grid h6 {
  font-weight: 500;
  font-family: "Courgette", cursive;
}  
.water-hover {
  width: 200px;
  height: 200px;
  border-radius: 15px;
  overflow: hidden;
  position: relative;
  display: inline-block;
  cursor: pointer;
} 
.water-hover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease, filter 0.4s ease;
}
.water-hover:hover img {
  transform: scale(1.05);
  filter: url(#waterRipple) brightness(1.08) saturate(1.3);
}
.water-hover::before,
.water-hover::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  opacity: 0;
  pointer-events: none;
}
.water-hover::before {
  border: 2px solid rgba(255,255,255,0.5);
}
.water-hover::after {
  border: 2px solid rgba(255,255,255,0.3);
}
.water-hover:hover::before {
  animation: ripple 1s ease-out forwards;
}
.water-hover:hover::after {
  animation: ripple 1s ease-out 0.15s forwards;
}

@@keyframes ripple {
  0% {
    width: 20px;
    height: 20px;
    opacity: 0.6;
  }
  100% {
    width: 300px;
    height: 300px;
    opacity: 0;
  }
}

#yap-grid ul li { 
  position: relative;
  overflow: hidden;
  z-index: 1;
  transition: box-shadow 0.25s ease;
}
#yap-grid ul li {
  position: relative;
  overflow: hidden;
  z-index: 1;
  border-radius: 6px; 
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    background-color 0.25s ease;
  display: inline-block;
  width: auto;
  max-width: 100%;
}
#yap-grid ul li::before {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.08);
  transform: scale(1);
  transition: transform 0.25s ease, opacity 0.25s ease;
  opacity: 0;
  z-index: 0;
} 
#yap-grid ul li:hover {  
  font-weight: 700; 
  transform: translateY(-3px) scale(1.02);
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.18);
  z-index: 10; 
} 
#yap-grid ul li:hover::before {
  transform: scale(1.05);
  opacity: 1; 
} 

@@media screen and (min-width: 1000px) { 
  #yap-grid ul li:hover {
    transform: translateY(-6px) scale(1.22) !important; 
    z-index: 50 !important; 
  } 
}
</style>

<div class="page-main uk-section uk-flex uk-flex-center">
  <div class="uk-width-1-1 uk-width-3-4@m uk-text-center">

    <h6 class="page-title uk-text-bold uk-text-center uk-margin-small-bottom">
      The Cultural Treasures of Yap
    </h6>

  <div id="yap-grid" class="uk-grid-divider uk-child-width-1-1@m uk-child-width-1-3@l uk-flex uk-flex-center" uk-grid> 

  <div class="uk-width-1-1">
        <h6 class="uk-text-normal uk-text-center uk-margin-xsmall-bottom">
          Yap State ~ The Federated States of Micronesia
        </h6>
  </div>

    <div class="water-hover uk-width-expand">
      <img src="~/images/pages/subpages/Hiking-&-Walking_3.jpg" alt="Explore Micronesia" style="width: 200px; height: 200px; border-radius: 15px;">  
    </div>

    <div class="uk-text-left@s uk-text-center">
      Yap, located in the Federated States of Micronesia, is celebrated for its
        strong traditional culture, peaceful island villages, and world-famous manta
        ray diving sites. Visitors to Yap can explore ancient stone money banks,
        experience traditional dances and navigation customs, and enjoy crystal-clear
        lagoons surrounded by lush tropical scenery. The island offers a rare blend
        of cultural heritage, marine adventure, and tranquil Pacific beauty.
    </div>

    <div> 
      <ul class="uk-list uk-list-divider uk-text-bold" style="font-size: 8px;">
        <li>
          Yap is famous for its giant stone money discs, known as Rai stones, which were traditionally used as a form of currency and remain an important cultural symbol today.
        </li>
        <li>
          The island is one of the best places in the world to dive with manta rays, offering crystal-clear waters and vibrant coral reef ecosystems.
        </li>
        <li>
          Traditional Yapese culture remains strong, with many villages preserving ancient customs, dances, canoe-building, and navigation practices.
        </li>
        <li>
          Yap’s tropical landscape includes dense forests, mangrove coastlines, quiet beaches, and small outer islands scattered across the Pacific Ocean.
        </li>
        <li>
          Visitors to Yap can experience a peaceful island atmosphere while learning about one of Micronesia’s most historically rich and culturally preserved states.
        </li>
      </ul>
    </div>

  </div>

  </div>
</div>

<svg style="display:none;">
  <filter id="waterRipple">
    <feTurbulence id="turbulence"
      type="fractalNoise"
      baseFrequency="0.008"
      numOctaves="3"
      seed="2"
      result="noise">
      <animate attributeName="baseFrequency"
               dur="4s"
               values="0.008;0.012;0.008"
               repeatCount="indefinite"/>
    </feTurbulence>

    <feDisplacementMap
      in="SourceGraphic"
      in2="noise"
      scale="0"
      xChannelSelector="R"
      yChannelSelector="G">
      <animate attributeName="scale"
               from="0"
               to="35"
               dur="0.4s"
               begin="mouseover"
               fill="freeze"/>
      <animate attributeName="scale"
               from="35"
               to="0"
               dur="0.6s"
               begin="mouseout"
               fill="freeze"/>
    </feDisplacementMap>
  </filter>
</svg>
