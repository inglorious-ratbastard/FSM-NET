            </div>
            <div>
                <img src="~/images/slides/YAP_Cover-Shot-Option-1.jpg" alt="" uk-cover>
            </div>
            <div>
                <img src="~/images/slides/do_yap_communityhouse.jpg" alt="" uk-cover>
            </div>
            <div>
