@model myapp.Pages.IslandModel

<style> 
.island-intro { 
    font-family: "Courgette", cursive;
    font-size: 12px !important;
    max-width: 500px;
    margin: -10px auto 12px auto;
    font-size: 0.95rem;
    line-height: 1.6; 
    letter-spacing: 0.2px;
} 
.island-container {
    width: 100%;
    max-width: 980px;
    margin: 0 auto;
} 
.island-grid {
    width: 100%;
    max-width: 850px;
    margin: 0 auto;
    padding-top: 10px;
    transform: translateY(20px);
}
.island-card {
    position: relative;
    overflow: hidden;
    border-radius: 18px;
    min-height: 125px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    text-decoration: none !important;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    box-shadow: 0 10px 25px rgba(0,0,0,0.18);
    border: 1px solid rgba(255,255,255,0.08);
}
.island-card:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 16px 32px rgba(0,0,0,0.28);
}
.island-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to top,
        rgba(0,0,0,0.70),
        rgba(0,0,0,0.15)
    );
    z-index: 1;
}
.island-card span {
    position: relative;
    z-index: 2;
    color: #fff;
    font-family: "EB Garamond", serif;
    font-size: 0.75rem;
    letter-spacing: 1px;
    margin-bottom: 14px;
    text-shadow: 0 2px 8px rgba(0,0,0,0.6);
}
.card-culture {
    background:
        linear-gradient(rgba(0,0,0,.15), rgba(0,0,0,.15)),
        url('/images/pages/photo-1507525428034-b723cf961d3e.jpg');
    background-size: cover;
    background-position: center;
}
.card-hospitality {
    background:
        linear-gradient(rgba(0,0,0,.15), rgba(0,0,0,.15)),
        url('/images/pages/photo-1519046904884-53103b34b206.jpg');
    background-size: cover;
    background-position: center;
}
.card-vibes {
    background:
        linear-gradient(rgba(0,0,0,.15), rgba(0,0,0,.15)),
        url('/images/pages/photo-1500375592092-40eb2168fd21.jpg');
    background-size: cover;
    background-position: center;
}
.card-around {
    background:
        linear-gradient(rgba(0,0,0,.15), rgba(0,0,0,.15)),
        url('/images/pages/photo-1493558103817-58b2924bce98.jpg');
    background-size: cover;
    background-position: center;
}
.card-island {
    background:
        linear-gradient(rgba(0,0,0,.15), rgba(0,0,0,.15)),
        url('/images/pages/photo-1501785888041-af3ef285b470.jpg');
    background-size: cover;
    background-position: center;
} 

@@media (min-width: 768px) and (max-width: 912px) {

    .island-grid .uk-grid > div {
        width: 100% !important;
    }

}
</style>

<div class="page-main uk-section uk-flex uk-flex-center"> 
    <div class="island-container uk-text-center">

        <h6 class="page-title uk-text-bold uk-text-center">  
            Life Among the Islands of Micronesia
        </h6>

        <p class="island-intro uk-text-center uk-margin-meduim-bottom">
            A scattered collection of island stories, culture, and coastal life — each one shaped by the sea and the people who call it home.
        </p>

        <div class="island-grid">
            <div class="uk-child-width-1-2@s uk-child-width-1-3@m uk-grid-small uk-flex-center" uk-grid>

                <div>
                    <a href="/Culture" class="island-card card-culture"> 
                        <span>Culture</span>
                    </a>
                </div>

                <div>
                    <a href="/Hospitality" class="island-card card-hospitality">
                        <span>Hospitality</span>
                    </a>
                </div>

                <div>
                    <a href="/Coastal" class="island-card card-vibes">
                        <span>Coastal Vibes</span>
                    </a>
                </div>

                <div>
                    <a href="/Around" class="island-card card-around">
                        <span>Getting Around</span>
                    </a>
                </div>

                <div>
                    <a href="/Voices" class="island-card card-island">
                        <span>Island Voices</span>
                    </a>
                </div>

            </div>
        </div>

    </div>
</div>
